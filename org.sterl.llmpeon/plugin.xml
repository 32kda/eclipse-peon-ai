<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Trigger-based completion providers (e.g. '@' files, '#' Java symbols).
        Implementations live in other bundles; the input widget stays provider-agnostic. -->
   <extension-point
         id="mentionProvider"
         name="Peon mention provider"
         schema="schema/mentionProvider.exsd"/>

   <!-- Bundle-contributed skills (short description + expandable body) and agents
        (description + prompt + curated tools). File-based skills/agents override by name. -->
   <extension-point
         id="skill"
         name="Peon skill provider"
         schema="schema/skill.exsd"/>
   <extension-point
         id="agent"
         name="Peon agent provider"
         schema="schema/agent.exsd"/>
   <extension-point
         id="tool"
         name="Peon tool provider"
         schema="schema/tool.exsd"/>
   <extension-point
         id="contextProvider"
         name="Peon context provider"
         schema="schema/contextProvider.exsd"/>
   <extension-point
         id="mcpServer"
         name="Peon in-process MCP server"
         schema="schema/mcpServer.exsd"/>

   <!-- S3.2: focused specialist sub-agents with curated tool sets (anti "god agent"). -->
   <extension point="org.sterl.llmpeon.agent">
      <agentProvider
            class="org.sterl.llmpeon.parts.contribution.BuiltInSpecialistAgents"
            name="Built-in specialists"/>
   </extension>

   <!-- '#' Java symbols via the native JDT type dialog. Optional: the java import of
        org.eclipse.jdt.ui is resolution:=optional, and a missing bundle is logged + skipped. -->
   <extension point="org.sterl.llmpeon.mentionProvider">
      <dialogProvider
            class="org.sterl.llmpeon.parts.mention.JavaSymbolMentionProvider"
            name="Java symbols"/>
   </extension>

   <extension
         id="org.sterl.llmpeon.fragment"
         point="org.eclipse.e4.workbench.model">
      <fragment
            apply="notexists"
            uri="fragment.e4xmi">
      </fragment>
   </extension>


   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="org.sterl.llmpeon.prefs.AiPeon"
            name="AI Peon"
            class="org.sterl.llmpeon.parts.config.AiPeonPreferencePage">
      </page>
      <page
            id="org.sterl.llmpeon.prefs.AiConfig"
            name="Peon configuration"
            category="org.sterl.llmpeon.prefs.AiPeon"
            class="org.sterl.llmpeon.parts.config.AiConfigPreferenceView">
      </page>
      
      <page
            id="org.sterl.llmpeon.prefs.AiAdvanced"
            name="Peon expert configuration"
            category="org.sterl.llmpeon.prefs.AiPeon"
            class="org.sterl.llmpeon.parts.config.AiAdvancedPreferenceView">
      </page>
      <page
            id="org.sterl.llmpeon.prefs.McpConfig"
            name="Peon MCP configuration"
            category="org.sterl.llmpeon.prefs.AiPeon"
            class="org.sterl.llmpeon.parts.config.McpPreferenceView">
      </page>
      <page
            id="org.sterl.llmpeon.prefs.VoiceConfig"
            name="Peon voice configuration"
            category="org.sterl.llmpeon.prefs.AiPeon"
            class="org.sterl.llmpeon.parts.config.VoicePreferenceView">
      </page>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="org.sterl.llmpeon.parts.config.LlmPreferenceInitializer"/>
      <initializer class="org.sterl.llmpeon.parts.config.McpPreferenceInitializer"/>
      <initializer class="org.sterl.llmpeon.parts.config.VoicePreferenceInitializer"/>
   </extension>

   <extension point="org.eclipse.e4.ui.css.swt.theme">
      <!-- Apply stylesheet to the Eclipse default/light theme -->
      <stylesheet uri="css/default-styles.css">
         <themeid refid="org.eclipse.e4.ui.css.theme.e4_default" />
      </stylesheet>
      <!-- Apply stylesheet to the Eclipse dark theme -->
      <stylesheet uri="css/dark-styles.css">
         <themeid refid="org.eclipse.e4.ui.css.theme.e4_dark" />
      </stylesheet>
   </extension>

</plugin>
