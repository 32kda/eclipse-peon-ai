<?xml version='1.0' encoding='UTF-8'?>
<?eclipse version="3.4"?>
<schema targetNamespace="org.sterl.llmpeon" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
  <appInfo>
    <meta.schema plugin="org.sterl.llmpeon" id="skill" name="Peon skill provider"/>
  </appInfo>
  <documentation>
    Contributes skills without files. The provider returns SkillDefinition entries
    (name, short description, expandable body, metadata). The description is injected
    into the prompt catalog; the body is only loaded by skillRead(name).

    Contributed skills have the lowest precedence: a config or project skill with the
    same lowercase name wins. The provider class must implement
    org.sterl.llmpeon.skill.SkillProvider and have a no-arg constructor.
  </documentation>
</annotation>

<element name="extension">
  <annotation>
    <appInfo>
      <meta.element/>
    </appInfo>
  </annotation>
  <complexType>
    <sequence>
      <element ref="skillProvider" minOccurs="1" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="point" type="string" use="required">
      <annotation>
        <documentation>
          The extension point id: org.sterl.llmpeon.skill
        </documentation>
      </annotation>
    </attribute>
    <attribute name="id" type="string">
      <annotation>
        <documentation>
          Optional unique id of the contribution.
        </documentation>
      </annotation>
    </attribute>
    <attribute name="name" type="string">
      <annotation>
        <documentation>
          Optional human-readable contribution name.
        </documentation>
      </annotation>
    </attribute>
  </complexType>
</element>

<element name="skillProvider">
  <complexType>
    <attribute name="class" type="string" use="required">
      <annotation>
        <documentation>
          Implementation of org.sterl.llmpeon.skill.SkillProvider.
        </documentation>
        <appInfo>
          <meta.attribute kind="java"/>
        </appInfo>
      </annotation>
    </attribute>
    <attribute name="name" type="string">
      <annotation>
        <documentation>
          Optional human-readable name used for diagnostics.
        </documentation>
      </annotation>
    </attribute>
  </complexType>
</element>

</schema>
